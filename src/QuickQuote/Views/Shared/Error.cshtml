@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<section class="shell confirmation">
    <div class="card confirmation__card confirmation__card--error">
        <span class="confirmation__icon confirmation__icon--error">!</span>
        <h1>Something went wrong</h1>
        <p class="confirmation__sub">
            An unexpected error interrupted your request. Nothing was charged, and no order was placed.
        </p>

        @if (Model.ShowRequestId)
        {
            <p class="confirmation__footnote">Reference ID: <code>@Model.RequestId</code></p>
        }
    </div>

    <a class="btn btn--ghost" asp-controller="Home" asp-action="Index">Back to plans</a>
</section>
