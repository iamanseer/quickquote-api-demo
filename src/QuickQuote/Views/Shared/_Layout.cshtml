<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · QuickQuote</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="shell site-header__inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand__mark">Q</span>
                <span class="brand__name">QuickQuote</span>
            </a>
            <span class="site-header__tagline">Checkout &amp; payments demo</span>
        </div>
    </header>

    <main class="pb-5">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="shell site-footer__inner">
            <p>QuickQuote is a portfolio demo. All payments run through Stripe <strong>test mode</strong> — no real money moves.</p>
            <p class="site-footer__meta">Built with ASP.NET Core MVC · Live rates via Frankfurter · Payments via Stripe</p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
