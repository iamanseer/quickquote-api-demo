@model CheckoutViewModel
@{
    ViewData["Title"] = $"Checkout · {Model.Product.Name}";
}

@await Html.PartialAsync("_StepIndicator", 2)

<section class="shell checkout">
    <div class="checkout__grid">
        <div class="card checkout__summary">
            <p class="eyebrow">Order summary</p>
            <h1 class="checkout__product-name">@Model.Product.Name</h1>
            <p class="checkout__product-desc">@Model.Product.Description</p>

            <div class="checkout__price-row">
                <span>Due today</span>
                <span class="checkout__price">$@Model.Product.PriceUsd.ToString("0.00") <small>USD</small></span>
            </div>

            <div class="fx-panel">
                <p class="fx-panel__title">Live conversion</p>

                @if (Model.ExchangeRates.Success)
                {
                    <ul class="fx-panel__list">
                        @foreach (var quote in Model.ExchangeRates.Quotes)
                        {
                            <li>
                                <span class="fx-panel__currency">@quote.Currency</span>
                                <span class="fx-panel__amount">@quote.ConvertedAmount.ToString("N2")</span>
                            </li>
                        }
                    </ul>
                    <p class="fx-panel__note">Rates from Frankfurter (European Central Bank reference rates), fetched live for this page.</p>
                }
                else
                {
                    <div class="alert alert--warning">
                        <strong>Currency conversion unavailable.</strong>
                        <span>@Model.ExchangeRates.ErrorMessage Pricing above stays in USD; a fresh rate is fetched again when you pay.</span>
                    </div>
                }
            </div>
        </div>

        <div class="card checkout__pay">
            <p class="eyebrow">Payment</p>
            <h2>Pay securely with Razorpay</h2>
            <p class="checkout__microcopy">
                You'll be redirected to Razorpay's own hosted payment page — QuickQuote never
                sees or stores your card or UPI details. Razorpay settles in INR, so you're
                charged the live-converted rupee price shown above, not a fixed number. This
                demo runs in Razorpay <strong>test mode</strong>, so no real charge is made.
            </p>

            @if (!string.IsNullOrEmpty(Model.PaymentError))
            {
                <div class="alert alert--error">
                    <strong>Payment couldn't start.</strong>
                    <span>@Model.PaymentError</span>
                </div>
            }

            <form method="post" asp-controller="Checkout" asp-action="Pay" asp-route-productId="@Model.Product.Id">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn--primary btn--block">
                    Pay $@Model.Product.PriceUsd.ToString("0.00") with Razorpay
                </button>
            </form>

            <ul class="trust-list">
                <li>256-bit encrypted checkout, hosted by Razorpay</li>
                <li>Test card 4111 1111 1111 1111, any future date, any CVV</li>
                <li>Or test UPI ID: success@razorpay</li>
            </ul>
        </div>
    </div>
</section>
